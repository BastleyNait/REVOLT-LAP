      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@800&family=Fira+Code:wght@400;600&display=swap');\n\n  :root {\n    --color-tactical-black: #0A0A0B;\n    --color-tactical-gray: #1A1C1E;\n    --color-electric-violet: #8B5CF6;\n    --color-acid-lime: #BEF264;\n    --color-acid-yellow: #FDE047;\n  }\n\n  body {\n    background-color: var(--color-tactical-black);\n    color: white;\n    font-family: 'Fira Code', monospace;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-display { font-family: 'Syne', sans-serif; }\n  \n  .hud-line {\n    position: absolute;\n    background: var(--color-electric-violet);\n    height: 1px;\n    opacity: 0.6;\n  }\n\n  .ticket-stub {\n    clip-path: polygon(0% 20px, 20px 20px, 20px 0%, calc(100% - 20px) 0%, calc(100% - 20px) 20px, 100% 20px, 100% calc(100% - 20px), calc(100% - 20px) calc(100% - 20px), calc(100% - 20px) 100%, 20px 100%, 20px calc(100% - 20px), 0% calc(100% - 20px));\n  }\n\n  .glow-violet { box-shadow: 0 0 20px rgba(139, 92, 246, 0.3); }\n  .glow-lime { box-shadow: 0 0 15px rgba(190, 242, 100, 0.4); }\n\n  .marquee-content {\n    display: flex;\n    animation: marquee 20s linear infinite;\n  }\n\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 4px; height: 4px; }\n  ::-webkit-scrollbar-track { background: var(--color-tactical-black); }\n  ::-webkit-scrollbar-thumb { background: var(--color-electric-violet); }\n</style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n\n\n<div class=\"fixed top-0 left-0 w-full z-50 border-b border-white/10 bg-tactical-black/80 backdrop-blur-md px-6 py-2 flex justify-between items-center text-[10px] uppercase tracking-widest\" data-kid=\"2\">\n  <div class=\"flex items-center gap-4\" data-kid=\"3\">\n    <span class=\"flex items-center gap-2\" data-kid=\"4\">\n      <span class=\"w-2 h-2 rounded-full bg-acid-lime animate-pulse shadow-[0_0_8px_#BEF264]\" data-kid=\"5\"></span>\n      SYSTEM STATUS: ONLINE\n    </span>\n    <span class=\"text-white/40\" data-kid=\"6\">SECURE TERMINAL // V.2.0.4</span>\n  </div>\n  <div class=\"flex gap-6\" data-kid=\"7\">\n    <a href=\"#\" class=\"hover:text-electric-violet transition-colors\" data-kid=\"8\">INVENTORY_LOG</a>\n    <a href=\"#\" class=\"hover:text-electric-violet transition-colors\" data-kid=\"9\">WARRANTY_DB</a>\n    <a href=\"#\" class=\"hover:text-electric-violet transition-colors\" data-kid=\"10\">CONTACT_X</a>\n  </div>\n</div>\n\n<main class=\"relative pt-20\" data-kid=\"11\">\n  \n  \n  <section class=\"min-h-screen flex flex-col items-center justify-center px-6 relative overflow-hidden\" data-kid=\"12\">\n    \n    <div class=\"absolute inset-0 opacity-10 pointer-events-none\" style=\"background-image: linear-gradient(var(--color-electric-violet) 1px, transparent 1px), linear-gradient(90deg, var(--color-electric-violet) 1px, transparent 1px); background-size: 40px 40px;\" data-kid=\"13\"></div>\n\n    \n    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] pointer-events-none\" data-kid=\"14\">\n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/target-shot.svg\" class=\"w-full h-full opacity-20 invert-[47%] sepia-[75%] saturate-[2786%] hue-rotate-[230deg] brightness-[100%] contrast-[101%]\" alt=\"Targeting Reticle\" data-kid=\"15\">\n    </div>\n\n    \n    <div class=\"relative z-10 text-center\" data-kid=\"16\">\n      <h1 class=\"font-display text-8xl md:text-[10rem] leading-none mb-4 tracking-tighter\" data-kid=\"17\">\n        RE<span class=\"text-electric-violet\" data-kid=\"18\">VOLT</span>\n      </h1>\n      <p class=\"text-xl uppercase tracking-[0.3em] mb-12 text-white/60\" data-kid=\"19\">Orbital Hardware Catalog</p>\n      \n      \n      <div class=\"relative group\" data-kid=\"20\">\n        <img src=\"https://images.unsplash.com/photo-1616560091035-863cdf9e23e6?auto=format&w=800&q=80&fit=crop\" class=\"w-[500px] grayscale group-hover:grayscale-0 transition-all duration-700 drop-shadow-[0_0_50px_rgba(139,92,246,0.2)]\" alt=\"Flagship Laptop\" data-kid=\"21\">\n        \n        \n        \n        <div class=\"absolute -top-12 -left-20 border border-electric-violet/50 bg-tactical-gray/80 p-3 backdrop-blur-sm text-left\" data-kid=\"22\">\n          <div class=\"text-[10px] text-electric-violet mb-1\" data-kid=\"23\">DATA_SOURCE: CPU_01</div>\n          <div class=\"text-sm font-bold\" data-kid=\"24\">M3 MAX CHIP</div>\n          <div class=\"text-[10px] text-acid-lime\" data-kid=\"25\">OVERCLOCKED: YES</div>\n          <div class=\"hud-line w-16 -right-16 top-1/2 rotate-12 origin-left\" data-kid=\"26\"></div>\n        </div>\n\n        \n        <div class=\"absolute top-20 -right-24 border border-electric-violet/50 bg-tactical-gray/80 p-3 backdrop-blur-sm text-left\" data-kid=\"27\">\n          <div class=\"text-[10px] text-electric-violet mb-1\" data-kid=\"28\">MEM_ALLOCATION</div>\n          <div class=\"text-sm font-bold\" data-kid=\"29\">32GB UNIFIED</div>\n          <div class=\"text-[10px] text-white/40\" data-kid=\"30\">STATUS: OPTIMAL</div>\n          <div class=\"hud-line w-24 -left-24 top-1/2 -rotate-12 origin-right\" data-kid=\"31\"></div>\n        </div>\n\n        \n        <div class=\"absolute -bottom-20 left-1/2 -translate-x-1/2 w-48 border border-white/10 bg-black overflow-hidden aspect-video\" data-kid=\"32\">\n           <video src=\"https://videos.pexels.com/video-files/33503700/14250432_640_360_30fps.mp4\" poster=\"https://images.pexels.com/videos/33503700/pexels-photo-33503700.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover opacity-60\" data-kid=\"33\"></video>\n           <div class=\"absolut