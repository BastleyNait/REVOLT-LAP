      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=IBM+Plex+Mono:wght@400;700&display=swap');\n\n  :root {\n    --ink-black: #080808;\n    --stark-white: #FFFFFF;\n    --acid-lime: #DFFF00;\n    --hot-pink: #FF007F;\n    --acid-yellow: #FFFF00;\n    --blueprint-line: rgba(255, 255, 255, 0.1);\n  }\n\n  body {\n    background-color: var(--ink-black);\n    color: var(--stark-white);\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .mono {\n    font-family: 'IBM Plex Mono', monospace;\n  }\n\n  .text-huge {\n    font-size: 12rem;\n    line-height: 0.8;\n    letter-spacing: -0.05em;\n    font-weight: 900;\n  }\n\n  .duotone-container {\n    background-color: var(--hot-pink);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .duotone-video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    filter: grayscale(1) contrast(1.2);\n    mix-blend-mode: multiply;\n  }\n\n  .ledger-row {\n    border-bottom: 6px solid var(--stark-white);\n    transition: all 0.2s steps(4);\n    cursor: crosshair;\n  }\n\n  .ledger-row:hover {\n    background-color: var(--acid-lime);\n    color: var(--ink-black);\n  }\n\n  .hover-image {\n    position: fixed;\n    pointer-events: none;\n    width: 300px;\n    z-index: 50;\n    display: none;\n    border: 4px solid var(--ink-black);\n    box-shadow: 10px 10px 0 var(--hot-pink);\n  }\n\n  .bg-blueprint {\n    background-image: \n      linear-gradient(var(--blueprint-line) 1px, transparent 1px),\n      linear-gradient(90deg, var(--blueprint-line) 1px, transparent 1px);\n    background-size: 50px 50px;\n  }\n\n  .marquee-content {\n    animation: marquee 20s linear infinite;\n  }\n\n  @keyframes marquee {\n    from { transform: translateX(0); }\n    to { transform: translateX(-50%); }\n  }\n\n  .outline-text {\n    -webkit-text-stroke: 2px var(--stark-white);\n    color: transparent;\n  }\n</style>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n\n\n<section class=\"h-screen flex flex-col\" data-kid=\"2\">\n  \n  <div class=\"h-[70vh] duotone-container relative\" data-kid=\"3\">\n    <video src=\"https://videos.pexels.com/video-files/13549718/13549718-sd_640_360_30fps.mp4\" poster=\"https://images.pexels.com/videos/13549718/4k-computer-computer-lights-cool-lights-13549718.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"duotone-video\" data-kid=\"4\"></video>\n    \n    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-kid=\"5\">\n      <h1 class=\"text-huge outline-text uppercase select-none opacity-40\" data-kid=\"6\">REVOLT</h1>\n    </div>\n\n    \n    <div class=\"absolute top-10 left-10 z-10\" data-kid=\"7\">\n      <div class=\"bg-stark-white text-ink-black px-6 py-2 font-bold mono text-sm tracking-widest\" data-kid=\"8\">\n        SYSTEM_STATUS: ONLINE // 2026.06.28\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"h-[30vh] bg-stark-white text-ink-black flex flex-col\" data-kid=\"9\">\n    <div class=\"flex-grow flex items-center px-20 border-b-2 border-ink-black/10\" data-kid=\"10\">\n      <nav class=\"flex gap-20 uppercase font-black text-2xl w-full justify-between items-baseline\" data-kid=\"11\">\n        <a href=\"#\" class=\"hover:text-hot-pink transition-colors\" data-kid=\"12\">Inventario</a>\n        <a href=\"#\" class=\"hover:text-hot-pink transition-colors\" data-kid=\"13\">Especificaciones</a>\n        <a href=\"#\" class=\"hover:text-hot-pink transition-colors\" data-kid=\"14\">Garantía</a>\n        <div class=\"text-sm mono text-right leading-tight max-w-xs\" data-kid=\"15\">\n          HARDWARE REACONDICIONADO DE GRADO MILITAR. <br data-kid=\"16\">\n          PRECISIÓN DIGITAL. ESTÉTICA BRUTALISTA.\n        </div>\n      </nav>\n    </div>\n    \n    \n    <a href=\"https://wa.me/revolt\" class=\"bg-ink-black text-stark-white h-24 flex items-center justify-center text-4xl font-black uppercase tracking-tighter hover:bg-hot-pink transition-all duration-300 group\" data-kid=\"17\">\n      Pedir por WhatsApp \n      <i class=\"ti ti-arrow-right ml-4 group-hover:translate-x-4 transition-transform\" data-kid=\"18\"></i>\n    </a>\n  </div>\n</section>\n\n\n<section class=\"min-h-screen pt-32 px-10\" data-kid=\"19\">\n  <div class=\"flex items-baseline justify-between mb-10\" data-kid=\"20\">\n    <h2 class=\"text-8xl font-black uppercase leading-none\" data-kid=\"21\">The Ledger</h2>\n    <div class=\"flex items-center gap-4 mono text-hot-pink\" data-kid=\"22\">\n      <i class=\"ti ti-database text-4xl\" data-kid=\"23\"></i>\n      <span class=\"text-xl\" data-kid=\"24\">DATA_SYNC_ACTIVE</span>\n    </div>\n  </div>\n\n  <table class=\"w-full border-t-6 border-stark-white\" data-kid=\"25\">\n    <thead data-kid=\"26\">\n      <tr class=\"mono text-left text-sm uppercase opacity-50\" data-kid=\"27\">\n        <th class=\"py-6 px-4\" data-kid=\"28\">Model_ID</th>\n        <th class=\"py-6 px-4\" data-kid=\"29\">Processor_Unit</th>\n        <th class=\"py-6 px-4\" data-kid=\"30\">Memory_Bank</th>\n        <th class=\"py-6 px-4\" data-kid=\"31\">Status_Grade</th>\n        <th class=\"py-6 px-4 text-right\" data-kid=\"32\">Price_Credit</th>\n      </tr>\n    </thead>\n    <tbody class=\"mono text-xl font-bold\" data-kid=\"33\">\n      <tr class=\"ledger-row\" data-image=\"https://images.unsplash.com/photo-1616560091035-863cdf9e23e6?auto=format&w=600&q=80&fit=crop\" data-kid=\"34\">\n        <td class=\"py-8 px-4\" data-kid=\"35\">THINKPAD X1 CARBON</td>\n        <td class=\"py-8 px-4\" data-kid=\"36\">INTEL i7 11TH GEN</td>\n        <td class=\"py-8 px-4\" data-kid=\"37\">16GB LPDDR4X</td>\n        <td class=\"py-8 px-4\" data-kid=\"38\"><span class=\"bg-hot-pink text-stark-white px-2 py-1\" data-kid=\"39\">GRADE_A</span></td>\n        <td class=\"py-8 px-4 text-right\" data-kid=\"40\">$799.00</td>\n      </tr>\n      <tr class=\"ledger-row\" data-image=\"https://images.unsplash.com/photo-1766203551890-2664b619042b?auto=format&w=600&q=80&fit=crop\" data-kid=\"41\">\n        <td class=\"py-8 px-4\" data-kid=\"42\">MACBOOK PRO M1</td>\n        <td class=\"py-8 px-4\" data-kid=\"43\">APPLE M1 8-CORE</td>\n        <td class=\"py-8 px-4\" data-kid=\"44\">16GB UNIFIED</td>\n        <td class=\"py-8 px-4\" data-kid=\"45\"><span class=\"bg-acid-yellow text-ink-black px-2 py-1\" data-kid=\"46\">MINT_CONDITION</span></td>\n        <td class=\"py-8 px-4 text-right\" data-kid=\"47\">$950.00</td>\n      </tr>\n      <tr class=\"ledger-row\" data-image=\"https://images.pexels.com/photos/1476321/pexels-photo-1476321.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\" data-kid=\"48\">\n        <td class=\"py-8 px-4\" data-kid=\"49\">DELL XPS 15 9520</td>\n        <td class=\"py-8 px-4\" data-kid=\"50\">INTEL i9 12TH GEN</td>\n        <td class=\"py-8 px-4\" data-kid=\"51\">32GB DDR5</td>\n        <td class=\"py-8 px-4\" data-kid=\"52\"><span class=\"bg-hot-pink text-stark-white px-2 py-1\" data-kid=\"53\">GRADE_B+</span></td>\n        <td class=\"py-8 px-4 text-right\" data-kid=\"54\">$1,100.00</td>\n      </tr>\n      <tr class=\"ledger-row\" data-image=\"https://images.pexels.com/photos/8108730/pexels-photo-8108730.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\" data-kid=\"55\">\n        <td class=\"py-8 px-4\" data-kid=\"56\">HP ELITEBOOK 840</td>\n        <td class=\"py-8 px-4\" data-kid=\"57\">INTEL i5 10TH GEN</td>\n        <td class=\"py-8 px-4\" data-kid=\"58\">08GB DDR4</td>\n        <td class=\"py-8 px-4\" data-kid=\"59\"><span class=\"bg-stark-white text-ink-black px-2 py-1\" data-kid=\"60\">CERTIFIED</span></td>\n        <td class=\"py-8 px-4 text-right\" data-kid=\"61\">$450.00</td>\n      </tr>\n    </tbody>\n  </table>\n</section>\n\n\n<img id=\"cursor-image\" src class=\"hover-image\" data-kid=\"62\">\n\n\n<section class=\"min-h-screen bg-blueprint py-32 px-10 relative overflow-hidden\" data-kid=\"63\">\n  \n  <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/cube.svg\" class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] opacity-5 pointer-events-none\" style=\"filter: invert(1);\" data-kid=\"64\">\n\n  <div class=\"relative z-10 max-w-6xl mx-auto\" data-kid=\"65\">\n    <h3 class=\"text-7xl font-black uppercase mb-4 tracking-tighter\" data-kid=\"66\">Engineering_Schematics</h3>\n    <p class=\"mono text-hot-pink mb-20 text-xl tracking-widest\" data-kid=\"67\">// ARCHIVE_REF_0392_LAPTOP_CORE</p>\n\n    <div class=\"grid grid-cols-12 gap-10\" data-kid=\"68\">\n      \n      <div class=\"col-span-8 border-2 border-stark-white/20 p-10 bg-ink-black/50 backdrop-blur-sm relative\" data-kid=\"69\">\n        <div class=\"absolute top-4 right-4 text-xs mono opacity-40\" data-kid=\"70\">SCALE: 1:1.002</div>\n        \n        <svg viewBox=\"0 0 800 500\" class=\"w-full stroke-stark-white fill-none opacity-80\" stroke-width=\"1\" data-kid=\"71\">\n          <rect x=\"50\" y=\"50\" width=\"700\" height=\"400\" data-kid=\"72\"></rect>\n          <rect x=\"70\" y=\"70\" width=\"660\" height=\"340\" stroke-dasharray=\"10 5\" data-kid=\"73\"></rect>\n          <path d=\"M50 450 L750 450 L780 480 L20 480 Z\" data-kid=\"74\"></path>\n          <rect x=\"200\" y=\"455\" width=\"400\" height=\"15\" opacity=\"0.5\" data-kid=\"75\"></rect>\n          <circle cx=\"400\" cy=\"240\" r=\"40\" stroke-dasharray=\"5 5\" data-kid=\"76\"></circle>\n          <line x1=\"400\" y1=\"200\" x2=\"400\" y2=\"100\" data-kid=\"77\"></line>\n          <line x1=\"400\" y1=\"280\" x2=\"400\" y2=\"400\" data-kid=\"78\"></line>\n          <text x=\"410\" y=\"120\" fill=\"white\" class=\"mono text-[10px]\" stroke=\"none\" data-kid=\"79\">THERMAL_ZONE_0</text>\n        </svg>\n      </div>\n\n      \n      <div class=\"col-span-4 flex flex-col gap-8\" data-kid=\"80\">\n        <div class=\"border-l-4 border-acid-lime pl-6\" data-kid=\"81\">\n          <h4 class=\"mono font-bold text-xl uppercase mb-2\" data-kid=\"82\">06_Month_Warranty</h4>\n          <p class=\"text-sm opacity-70 leading-relaxed\" data-kid=\"83\">\n            Cada unidad es sometida a un diagnóstico de 48 puntos en nuestro laboratorio. Reemplazamos pasta térmica y optimizamos el flujo de aire.\n          </p>\n        </div>\n        \n        <div class=\"border-l-4 border-hot-pink pl-6\" data-kid=\"84\">\n          <h4 class=\"mono font-bold text-xl uppercase mb-2\" data-kid=\"85\">Stress_Testing</h4>\n          <p class=\"text-sm opacity-70 leading-relaxed\" data-kid=\"86\">\n            Pruebas de carga de GPU/CPU por 12 horas continuas para asegurar estabilidad absoluta bajo condiciones extremas.\n          </p>\n        </div>\n\n        <div class=\"border-l-4 border-stark-white pl-6\" data-kid=\"87\">\n          <h4 class=\"mono font-bold text-xl uppercase mb-2\" data-kid=\"88\">Battery_Health</h4>\n          <p class=\"text-sm opacity-70 leading-relaxed\" data-kid=\"89\">\n            Garantizamos una salud de batería superior al 85%. Si no cumple, instalamos una celda nueva original.\n          </p>\n        </div>\n\n        <div class=\"mt-auto bg-stark-white text-ink-black p-6 font-black text-center uppercase tracking-widest text-sm\" data-kid=\"90\">\n          No Compromises. Just Performance.\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<footer class=\"bg-hot-pink py-4 overflow-hidden border-t-6 border-ink-black\" data-kid=\"91\">\n  <div class=\"marquee-content whitespace-nowrap inline-block text-ink-black font-black text-3xl uppercase\" data-kid=\"92\">\n    REVOLT HARDWARE ARCHIVES // STOCK_LIMITADO // ENVÍO_NACIONAL_ASEGURADO // REVOLT HARDWARE ARCHIVES // STOCK_LIMITADO // ENVÍO_NACIONAL_ASEGURADO // REVOLT HARDWARE ARCHIVES // STOCK_LIMITADO // ENVÍO_NACIONAL_ASEGURADO\n  </div>\n</footer>\n\n<script data-kid=\"93\">\n  const ledgerRows = document.querySelectorAll('.ledger-row');\n  const cursorImg = document.getElementById('cursor-image');\n\n  ledgerRows.forEach(row => {\n    row.addEventListener('mouseenter', (e) => {\n      cursorImg.src = row.dataset.image;\n      cursorImg.style.display = 'block';\n    });\n\n    row.addEventListener('mouseleave', () => {\n      cursorImg.style.display = 'none';\n    });\n\n    row.addEventListener('mousemove', (e) => {\n      cursorImg.style.top = (e.clientY + 20) + 'px';\n      cursorImg.style.left = (e.clientX + 20) + 'px';\n    });\n  });\n</script>",
