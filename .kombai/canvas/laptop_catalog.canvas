      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&family=JetBrains+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-bg: #161310;\n    --color-acid: #CCFF00;\n    --color-pink: #FF007F;\n    --color-lime: #32CD32;\n    --border-thick: 4px;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: white;\n    font-family: 'JetBrains Mono', monospace;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-display { font-family: 'Space Grotesk', sans-serif; }\n\n  /* Glassmorphism Utility */\n  .glass {\n    background: rgba(255, 255, 255, 0.05);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  /* Claymorphism Utility */\n  .clay-btn {\n    background: var(--color-pink);\n    border-radius: 12px;\n    box-shadow: \n      inset 0 4px 8px rgba(255, 255, 255, 0.3),\n      inset 0 -4px 8px rgba(0, 0, 0, 0.3),\n      0 10px 20px rgba(255, 0, 127, 0.2);\n    transition: all 0.3s ease;\n  }\n  \n  .clay-btn:hover {\n    transform: translateY(-2px);\n    box-shadow: \n      inset 0 6px 10px rgba(255, 255, 255, 0.4),\n      inset 0 -6px 10px rgba(0, 0, 0, 0.4),\n      0 15px 25px rgba(255, 0, 127, 0.3);\n  }\n\n  .clay-card {\n    background: rgba(255, 255, 255, 0.03);\n    border-radius: 24px;\n    box-shadow: \n      inset 0 2px 4px rgba(255, 255, 255, 0.1),\n      inset 0 -2px 4px rgba(0, 0, 0, 0.2),\n      8px 8px 0px 0px var(--color-acid);\n  }\n\n  .marquee-content {\n    display: flex;\n    animation: marquee 20s linear infinite;\n  }\n\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  .caution-tape {\n    background: repeating-linear-gradient(\n      -45deg,\n      #CCFF00,\n      #CCFF00 10px,\n      #000 10px,\n      #000 20px\n    );\n  }\n\n  .grid-pattern {\n    background-image: radial-gradient(rgba(204, 255, 0, 0.1) 1px, transparent 1px);\n    background-size: 40px 40px;\n  }\n\n  .text-outline {\n    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);\n    color: transparent;\n  }\n</style>\n\n<div class=\"min-h-screen grid-pattern relative\" data-kid=\"1\">\n  \n  <div class=\"fixed top-1/4 left-1/4 w-96 h-96 bg-[var(--color-acid)]/10 blur-[120px] rounded-full -z-10\" data-kid=\"2\"></div>\n  <div class=\"fixed bottom-1/4 right-1/4 w-96 h-96 bg-[var(--color-pink)]/10 blur-[120px] rounded-full -z-10\" data-kid=\"3\"></div>\n  \n  <div class=\"bg-black/80 backdrop-blur-sm border-b-2 border-[var(--color-acid)]/30 overflow-hidden py-2 sticky top-0 z-50\" data-kid=\"4\">\n    <div class=\"marquee-content whitespace-nowrap\" data-kid=\"5\">\n      <span class=\"text-[var(--color-acid)] font-bold px-4 text-xs opacity-80\" data-kid=\"6\">STOCK LIMITADO // RENDIMIENTO SIN COMPROMISOS // CONEXIÓN SEGURA ESTABLECIDA // HARDWARE BRUTAL // </span>\n      <span class=\"text-[var(--color-acid)] font-bold px-4 text-xs opacity-80\" data-kid=\"7\">STOCK LIMITADO // RENDIMIENTO SIN COMPROMISOS // CONEXIÓN SEGURA ESTABLECIDA // HARDWARE BRUTAL // </span>\n    </div>\n  </div>\n\n  \n  <section class=\"container mx-auto px-6 py-24 flex flex-col md:flex-row gap-16 items-center\" data-kid=\"8\">\n    <div class=\"w-full md:w-1/2\" data-kid=\"9\">\n      <div class=\"relative inline-block\" data-kid=\"10\">\n        <h1 class=\"font-display text-7xl md:text-9xl leading-[0.8] tracking-tighter mb-4 flex flex-col\" data-kid=\"11\">\n          <span class=\"text-[var(--color-acid)]\" data-kid=\"12\">LAPTOPS</span>\n          <span class=\"text-outline\" data-kid=\"13\">BRUTALES</span>\n        </h1>\n        <div class=\"absolute -top-6 -left-4 glass px-4 py-1 font-bold text-[10px] uppercase tracking-widest text-[var(--color-acid)]\" data-kid=\"14\">\n          Mainframe OS v2.0 // Glass-Clay Hybrid\n        </div>\n      </div>\n      <p class=\"text-lg text-gray-400 max-w-md mt-10 border-l-2 border-[var(--color-pink)] pl-6 py-2 leading-relaxed\" data-kid=\"15\">\n        HARDWARE REACONDICIONADO PARA LA ÉLITE. EVOLUCIONADO CON DISEÑO VANGUARDISTA.\n      </p>\n      <button class=\"mt-12 clay-btn text-black font-bold px-10 py-5 uppercase tracking-widest text-sm\" data-kid=\"16\">\n        INICIAR CONEXIÓN\n      </button>\n    </div>\n\n    <div class=\"w-full md:w-1/2 relative group\" data-kid=\"17\">\n      <div class=\"glass p-4 rounded-[32px] border border-white/10 shadow-2xl transition-transform duration-700 group-hover:scale-[1.02]\" data-kid=\"18\">\n        <div class=\"rounded-[24px] overflow-hidden border-2 border-black/50\" data-kid=\"19\">\n          <img src=\"https://images.pexels.com/photos/3520679/pexels-photo-3520679.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" alt=\"Motherboard\" class=\"w-full grayscale group-hover:grayscale-0 transition-all duration-700\" decoding=\"async\" loading=\"lazy\" data-kid=\"20\">\n        </div>\n      </div>\n      \n      <div class=\"absolute -bottom-8 -right-8 bg-[var(--color-acid)] text-black px-6 py-3 rounded-2xl font-bold text-xs uppercase shadow-[inset_0_2px_4px_rgba(255,255,255,0.5),8px_8px_0px_0px_rgba(0,0,0,1)] rotate-3\" data-kid=\"21\">\n        TACTICAL_HARDWARE\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"container mx-auto px-6 py-24\" data-kid=\"22\">\n    <div class=\"flex items-center gap-6 mb-16\" data-kid=\"23\">\n      <h2 class=\"font-display text-5xl uppercase tracking-tighter\" data-kid=\"24\">Inventory_Nodes</h2>\n      <div class=\"h-[1px] grow bg-gradient-to-r from-[var(--color-acid)] to-transparent\" data-kid=\"25\"></div>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10\" data-kid=\"26\">\n      \n      <div class=\"clay-card p-8 group transition-all duration-500 hover:-translate-y-2\" data-kid=\"27\">\n        <div class=\"relative mb-8\" data-kid=\"28\">\n          <div class=\"aspect-video glass rounded-2xl overflow-hidden border border-white/10\" data-kid=\"29\">\n            <img src=\"https://images.unsplash.com/photo-1616560091035-863cdf9e23e6?auto=format&w=400&q=80&fit=crop\" alt=\"Laptop\" class=\"w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity\" decoding=\"async\" loading=\"lazy\" data-kid=\"30\">\n          </div>\n          <div class=\"absolute -top-3 -right-3 caution-tape px-4 py-1 rounded-full text-[9px] font-bold text-black border border-black/20\" data-kid=\"31\">\n            CERTIFIED_RECON\n          </div>\n        </div>\n\n        <h3 class=\"font-display text-2xl mb-2 text-[var(--color-acid)] uppercase\" data-kid=\"32\">ThinkPad X1 Carbon</h3>\n        <p class=\"text-[10px] text-gray-500 mb-6 font-bold tracking-widest\" data-kid=\"33\">NODE_ID: RL-7729-N</p>\n        \n        <div class=\"glass rounded-xl p-4 mb-8\" data-kid=\"34\">\n          <table class=\"w-full text-[10px] text-[var(--color-lime)]\" data-kid=\"35\">\n            <tr class=\"border-b border-white/5\" data-kid=\"36\">\n              <td class=\"py-2 opacity-60\" data-kid=\"37\">CPU</td>\n              <td class=\"py-2 text-right\" data-kid=\"38\">CORE I7-1185G7</td>\n            </tr>\n            <tr class=\"border-b border-white/5\" data-kid=\"39\">\n              <td class=\"py-2 opacity-60\" data-kid=\"40\">RAM</td>\n              <td class=\"py-2 text-right\" data-kid=\"41\">16GB LPDDR4X</td>\n            </tr>\n          </table>\n        </div>\n\n        <div class=\"flex justify-between items-center\" data-kid=\"42\">\n          <div class=\"text-3xl font-bold font-display\" data-kid=\"43\">$849</div>\n          <button class=\"w-12 h-12 clay-btn flex items-center justify-center text-black rounded-full\" data-kid=\"44\">\n            <i class=\"ti ti-plus text-xl\" data-kid=\"45\"></i>\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"clay-card p-8 bg-gradient-to-br from-white/5 to-transparent border-2 border-[var(--color-pink)]/30 shadow-[12px_12px_0px_0px_var(--color-pink)] md:col-span-2 lg:col-span-1\" data-kid=\"46\">\n        <div class=\"glass px-3 py-1 rounded-lg inline-block mb-6\" data-kid=\"47\">\n          <span class=\"text-[var(--color-pink)] text-[9px] font-bold tracking-widest\" data-kid=\"48\">SYSTEM_PRIORITY_NODE</span>\n        </div>\n        \n        <div class=\"aspect-video glass rounded-2xl overflow-hidden mb-8 relative\" data-kid=\"49\">\n          <img src=\"https://images.unsplash.com/photo-1766203551890-2664b619042b?auto=format&w=600&q=80&fit=crop\" alt=\"Mac\" class=\"w-full h-full object-cover opacity-40 grayscale group-hover:grayscale-0\" decoding=\"async\" loading=\"lazy\" data-kid=\"50\">\n          <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none\" data-kid=\"51\">\n            <i class=\"ti ti-cpu text-6xl text-[var(--color-acid)] blur-[2px] opacity-30\" data-kid=\"52\"></i>\n          </div>\n        </div>\n\n        <h3 class=\"font-display text-3xl mb-2 text-white uppercase\" data-kid=\"53\">MacBook Pro M1 Max</h3>\n        <p class=\"text-[10px] text-gray-500 mb-8 font-bold tracking-widest\" data-kid=\"54\">STATUS: OPTIMIZED</p>\n\n        <div class=\"flex justify-between items-center mt-auto\" data-kid=\"55\">\n          <div class=\"text-4xl font-bold font-display text-[var(--color-acid)]\" data-kid=\"56\">$1,599</div>\n          <button class=\"clay-btn bg-[var(--color-pink)] text-black px-6 py-3 font-bold text-xs uppercase tracking-tighter\" data-kid=\"57\">\n            SYNC_NODE\n          </button>\n        </div>\n      </div>\n\n      \n      <div class=\"clay-card p-8 group\" data-kid=\"58\">\n        <div class=\"aspect-video glass rounded-2xl overflow-hidden mb-8 border border-white/10\" data-kid=\"59\">\n          <img src=\"https://images.unsplash.com/photo-1723249489883-d2aa011bdb8c?auto=format&w=400&q=80&fit=crop\" alt=\"Dell\" class=\"w-full h-full object-cover opacity-60\" decoding=\"async\" loading=\"lazy\" data-kid=\"60\">\n        </div>\n        <h3 class=\"font-display text-2xl mb-2 text-[var(--color-acid)] uppercase\" data-kid=\"61\">Dell Latitude 7420</h3>\n        <div class=\"glass rounded-xl p-4 mt-6\" data-kid=\"62\">\n          <div class=\"flex justify-between text-[10px] text-[var(--color-lime)] opacity-80 uppercase\" data-kid=\"63\">\n            <span data-kid=\"64\">CORE I5</span>\n            <span data-kid=\"65\">8GB RAM</span>\n          </div>\n        </div>\n        <div class=\"flex justify-between items-center mt-10\" data-kid=\"66\">\n          <div class=\"text-3xl font-bold font-display\" data-kid=\"67\">$425</div>\n          <button class=\"w-12 h-12 clay-btn bg-[var(--color-acid)] text-black flex items-center justify-center rounded-full\" data-kid=\"68\">\n            <i class=\"ti ti-plus text-xl\" data-kid=\"69\"></i>\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"container mx-auto px-6 py-24 mb-20\" data-kid=\"70\">\n    <div class=\"glass rounded-[40px] p-12 border border-white/5 shadow-inner\" data-kid=\"71\">\n      <h2 class=\"font-display text-5xl mb-16 uppercase italic tracking-tighter text-[var(--color-pink)]\" data-kid=\"72\">Diagnostic_Logs</h2>\n      \n      <div class=\"space-y-6\" data-kid=\"73\">\n        <div class=\"glass rounded-2xl p-6 flex justify-between items-center group cursor-pointer hover:bg-white/10 transition-all border border-white/10\" data-kid=\"74\">\n          <span class=\"font-bold flex items-center gap-4 text-xs tracking-widest\" data-kid=\"75\">\n            <i class=\"ti ti-cpu text-[var(--color-acid)] text-lg\" data-kid=\"76\"></i>\n            PROCESS_01: TESTING_CORE_STABILITY\n          </span>\n          <div class=\"w-8 h-8 clay-btn bg-white/10 flex items-center justify-center rounded-lg\" data-kid=\"77\">\n            <i class=\"ti ti-plus text-white\" data-kid=\"78\"></i>\n          </div>\n        </div>\n\n        <div class=\"glass rounded-2xl p-6 flex justify-between items-center border border-[var(--color-acid)]/30 bg-[var(--color-acid)]/5\" data-kid=\"79\">\n          <span class=\"font-bold flex items-center gap-4 text-xs tracking-widest text-[var(--color-acid)]\" data-kid=\"80\">\n            <i class=\"ti ti-shield-check text-lg\" data-kid=\"81\"></i>\n            WARRANTY_STATUS: ACTIVE_SECURE\n          </span>\n          <div class=\"w-8 h-8 clay-btn bg-[var(--color-acid)] flex items-center justify-center rounded-lg\" data-kid=\"82\">\n            <i class=\"ti ti-plus text-black\" data-kid=\"83\"></i>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-black/80 backdrop-blur-md border-t border-white/10 p-12\" data-kid=\"84\">\n    <div class=\"container mx-auto flex flex-col md:flex-row justify-between items-center gap-12\" data-kid=\"85\">\n      <div class=\"font-display text-7xl text-white tracking-tighter mix-blend-difference\" data-kid=\"86\">REVOLT</div>\n      <div class=\"glass p-6 rounded-3xl flex flex-col md:items-end gap-4 border border-white/10\" data-kid=\"87\">\n        <div class=\"text-[10px] font-bold tracking-[0.3em] uppercase opacity-50\" data-kid=\"88\">© 2026 REVOLT SYSTEMS // ALL_RIGHTS_RESERVED</div>\n        <div class=\"flex gap-4\" data-kid=\"89\">\n          <div class=\"w-10 h-10 clay-btn bg-white/5 flex items-center justify-center text-white rounded-xl hover:bg-[var(--color-acid)] hover:text-black\" data-kid=\"90\">\n            <i class=\"ti ti-brand-instagram\" data-kid=\"91\"></i>\n          </div>\n          <div class=\"w-10 h-10 clay-btn bg-white/5 flex items-center justify-center text-white rounded-xl hover:bg-[var(--color-pink)]\" data-kid=\"92\">\n            <i class=\"ti ti-brand-discord\" data-kid=\"93\"></i>\n          </div>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>",
