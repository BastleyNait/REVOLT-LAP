# ----------------------------------------------------------------------------
# Supabase  (Project settings → API)
# ----------------------------------------------------------------------------
# Public — safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://ygdllzaoioolkbxusnlx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UjaEedNdD-KhT6ckKM4_Zg_SwUzbZqH

# Secret — server only, NEVER prefixed with NEXT_PUBLIC. Powers admin writes.
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

# ----------------------------------------------------------------------------
# Admin dashboard
# ----------------------------------------------------------------------------
# Password required to access /admin. If left empty, /admin is OPEN (dev only).
ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Site / WhatsApp
# ----------------------------------------------------------------------------
# Canonical site URL (used for metadata + WhatsApp deep links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in E.164 WITHOUT the leading "+", e.g. 5215512345678.
# Empty => buttons open a generic WhatsApp share sheet.
NEXT_PUBLIC_WHATSAPP_PHONE=

# Reference exchange rate used to show the USD equivalent of soles (PEN) prices.
# 1 USD = X PEN. Defaults to 3.7 if unset.
NEXT_PUBLIC_USD_RATE=3.7
