# ----------------------------------------------------------------------------
# Supabase  (Project settings → API)
# ----------------------------------------------------------------------------
# Public — safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://ygdllzaoioolkbxusnlx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UjaEedNdD-KhT6ckKM4_Zg_SwUzbZqH

# Secret — server only, NEVER prefixed with NEXT_PUBLIC. Powers admin writes.
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

# ----------------------------------------------------------------------------
# Admin dashboard
# ----------------------------------------------------------------------------
# Password required to access /admin. If left empty, /admin is OPEN (dev only).
ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Site / WhatsApp
# ----------------------------------------------------------------------------
# Canonical site URL (metadata, canonical tags, sitemap, JSON-LD, WhatsApp links).
# In production set it to the custom domain, e.g. https://revolt.pe
# (if unset on Vercel, the production domain is used automatically).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_PHONE=
NEXT_PUBLIC_USD_RATE=3.7

# Optional: verification tokens for Google Search Console / Bing Webmaster
# (paste only the content="..." value of the meta tag they give you).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Cloudflare R2 (Image hosting) ─────────────────────────────────
# Bucket name (e.g. "revolt-images")
R2_BUCKET=revolt-images
# Account ID from Cloudflare Dashboard → API → Account ID
R2_ACCOUNT_ID=your-account-id
# API Token scoped to the bucket (create via Cloudflare Dashboard → R2 → API Tokens)
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
# Public CDN URL (e.g. "https://cdn.yourdomain.com" or R2 edge URL)
R2_PUBLIC_URL=https://pub-xxx.r2.dev
